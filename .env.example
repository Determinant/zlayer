# The historical VITE_ZLAYERS_ prefix remains supported after the ZLayer rename.
# Blank uses Vite's same-origin proxy in development and charts.tedyin.com in builds.
VITE_ZLAYERS_CHART_ROOT=
# Blank or latest discovers the newest supported published cycle. A date sets the initial selection.
VITE_ZLAYERS_CHART_REVISION=
# Blank METAR/TAF: same-origin /api/weather/ routes to the TypeScript AWC gateway.
# npm run dev proxies to https://zlayer.tedyin.com, sharing the GCP backend through DO's HTTPS proxy.
# To develop the backend, run npm run weather:serve in another terminal, then
# WEATHER_API_ORIGIN=http://127.0.0.1:8787 npm run dev (shell environment only).
# Explicit report URLs must retain the AWC GeoJSON/JSON contracts.
VITE_ZLAYERS_METAR_URL=
VITE_ZLAYERS_TAF_URL=
# Vite supplies this FAA-only proxy locally; production needs it for individual-only plates.
VITE_ZLAYERS_PROCEDURE_PROXY_ROOT=/faa-procedures
VITE_ZLAYERS_BASEMAP_STYLE_URL=
# Fallback Terrarium-encoded 256px elevation tiles; blank uses Mapzen on AWS.
# Published charts/terrain packages and saved terrain take precedence.
VITE_ZLAYERS_TERRAIN_TILE_URL=
VITE_ZLAYERS_BASEMAP_TILE_URL=https://basemap.nationalmap.gov/arcgis/rest/services/USGSTopo/MapServer/tile/{z}/{y}/{x}
# Optional published advisory feed; blank uses the AWC gateway for all advisories.
# VITE_ZLAYERS_AWC_FEED_URL=https://example.com/api/weather/advisories/

# Leave blank: /api/weather/grids/ serves prepared HRRR and IFI numeric grids.
# The weather server acquires HRRR from Google and IFI from NOMADS.
# An explicit URL is only for compatibility with preconverted fixtures/archived feeds.
VITE_ZLAYERS_AWC_GRID_URL=
