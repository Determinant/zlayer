# The historical VITE_ZLAYERS_ prefix remains supported after the ZLayer rename.
# Blank uses Vite's same-origin proxy in development and charts.tedyin.com in builds.
VITE_ZLAYERS_CHART_ROOT=
# Blank or latest discovers the newest supported published cycle. A date sets the initial selection.
VITE_ZLAYERS_CHART_REVISION=
VITE_ZLAYERS_METAR_URL=/weather/metars.geojson
VITE_ZLAYERS_TAF_URL=/weather/tafs.json
# Vite supplies this FAA-only proxy locally; production needs it for individual-only plates.
VITE_ZLAYERS_PROCEDURE_PROXY_ROOT=/faa-procedures
VITE_ZLAYERS_BASEMAP_STYLE_URL=
# Optional Terrarium-encoded 256px elevation tiles; blank uses Mapzen terrain on AWS.
VITE_ZLAYERS_TERRAIN_TILE_URL=
VITE_ZLAYERS_BASEMAP_TILE_URL=https://basemap.nationalmap.gov/arcgis/rest/services/USGSTopo/MapServer/tile/{z}/{y}/{x}
