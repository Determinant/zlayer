# Keep the installed file outside the web/config mounts (e.g. /etc/zlayer-hosting).
CADDY_IMAGE=caddy@sha256:REPLACE_WITH_VERIFIED_DIGEST
APP_DOMAIN=zlayer.example.com
CHARTS_DOMAIN=charts.example.com
INFO_UPSTREAM=127.0.0.1:8787
TLS_MODE=bootstrap
# Optional per-host overrides for a staged DNS migration:
# APP_TLS_MODE=bootstrap
# CHARTS_TLS_MODE=managed
APP_DATA_DIR=/srv/zlayer-hosting/app
FAA_DATA_DIR=/srv/zlayer-hosting/faa
TLS_BOOTSTRAP_DIR=/etc/zlayer-hosting/bootstrap
CADDY_DATA_DIR=/var/lib/zlayer-hosting/caddy
CADDY_CONFIG_DIR=/var/lib/zlayer-hosting/config
